@model IEnumerable<QuestionIndexViewModel>

@{
    ViewData["Title"] = "Question Bank";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Question Bank</h2>
    <div>
        <a asp-action="Create" class="btn btn-primary me-2">+ New Question</a>
        <a asp-action="Import" class="btn btn-secondary me-2">Import Questions</a>
        <a asp-action="AIGenerate" class="btn btn-info">AI Generate</a>
        <a asp-action="Pending" class="btn btn-warning">Pending Review (@Model.Count(q => q.Status == "Pending"))</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Question</th>
                    <th>Course</th>
                    <th>Topic</th>
                    <th>Bloom Level</th>
                    <th>Status</th>
                    <th>Source</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in Model)
                {
                    <tr>
                        <td>@q.Id</td>
                        <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@q.Text">@q.Text</td>
                        <td>@q.CourseName</td>
                        <td>@q.TopicName</td>
                        <td>
                            <span class="badge @(q.BloomLevel == "Remember" ? "bg-secondary" : q.BloomLevel == "Understand" ? "bg-info" : q.BloomLevel == "Apply" ? "bg-warning" : "bg-success")">
                                @q.BloomLevel
                            </span>
                        </td>
                        <td>
                            <span class="badge @(q.Status == "Approved" ? "bg-success" : q.Status == "Pending" ? "bg-warning" : "bg-danger")">
                                @q.Status
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark">@q.SourceType</span>
                        </td>
                        <td>@q.CreatedAt:dd/MM/yyyy</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary me-1">View</a>
                            <a asp-action="Edit" asp-route-id="@q.Id" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                            <form asp-action="Delete" asp-route-id="@q.Id" method="post" class="d-inline" onsubmit="return confirm(\\"Delete this question?\\");">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No questions found. Create your first question or import questions.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-link">&larr; Back to Home</a>
</div>
