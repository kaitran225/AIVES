@model QuestionCreateViewModel

@{
    ViewData["Title"] = "Create Question";
}

<h2>Create Question</h2>

<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Text" class="form-label">Question Text *</label>
                <textarea asp-for="Text" class="form-control" rows="3" required></textarea>
                <span asp-validation-for="Text" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReferenceAnswer" class="form-label">Reference Answer</label>
                <textarea asp-for="ReferenceAnswer" class="form-control" rows="3"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="BloomLevel" class="form-label">Bloom Level *</label>
                    <select asp-for="BloomLevel" class="form-select" required>
                        <option value="">-- Select --</option>
                        <option value="Remember">Remember</option>
                        <option value="Understand">Understand</option>
                        <option value="Apply">Apply</option>
                        <option value="Analyze">Analyze</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SourceType" class="form-label">Source Type</label>
                    <select asp-for="SourceType" class="form-select">
                        <option value="Manual">Manual</option>
                        <option value="AI">AI Generated</option>
                        <option value="Imported">Imported</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CourseId" class="form-label">Course *</label>
                    <select asp-for="CourseId" class="form-select" required
                            asp-items="@(new SelectList(Model.Courses, "Value", "Text"))">
                        <option value="">-- Select Course --</option>
                    </select>
                    <span asp-validation-for="CourseId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TopicId" class="form-label">Topic</label>
                    <select asp-for="TopicId" class="form-select"
                            asp-items="@(new SelectList(Model.Topics, "Value", "Text"))">
                        <option value="">-- Select Topic --</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="RubricId" class="form-label">Rubric</label>
                <select asp-for="RubricId" class="form-select"
                        asp-items="@(new SelectList(Model.Rubrics, "Value", "Text"))">
                    <option value="">-- No Rubric --</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
