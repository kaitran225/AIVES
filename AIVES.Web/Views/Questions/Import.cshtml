@model QuestionCreateViewModel

@{
    ViewData["Title"] = "Import Questions";
}

<h2>Import Questions</h2>
<p class="text-muted">Paste questions below (one per line). Each question will be created with "Imported" source type and "Pending" status.</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-8">
        <form asp-action="Import" method="post">
            <div class="mb-3">
                <label class="form-label">Course</label>
                <select asp-for="CourseId" class="form-select"
                        asp-items="@(new SelectList(Model.Courses, "Value", "Text"))">
                    <option value="">-- Select Course --</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Questions (one per line)</label>
                <textarea name="content" class="form-control" rows="10" placeholder="What is a class?&#10;Explain polymorphism.&#10;What is inheritance?" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Import Questions</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
