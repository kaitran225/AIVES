@model IEnumerable<QuestionIndexViewModel>

@{
    ViewData["Title"] = "Pending Review";
}

<h2>Pending Questions</h2>
<p class="text-muted">AI-generated questions awaiting lecturer review.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No pending questions. All AI-generated questions have been reviewed.</div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Question</th>
                        <th>Course</th>
                        <th>Bloom Level</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@q.Text">@q.Text</td>
                            <td>@q.CourseName</td>
                            <td><span class="badge bg-info">@q.BloomLevel</span></td>
                            <td>@q.CreatedAt:dd/MM/yyyy</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary me-1">Review</a>
                                <a asp-action="Edit" asp-route-id="@q.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link">&larr; Back to Question Bank</a>
</div>
