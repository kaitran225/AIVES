@model RubricCreateViewModel

@{
    ViewData["Title"] = "Create Rubric";
}

<h2>Create Rubric</h2>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label">Rubric Name *</label>
                <input asp-for="Name" class="form-control" placeholder="e.g., Technical Understanding" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Maximum Score *</label>
                <input asp-for="MaxScore" type="number" class="form-control" value="4" min="1" max="10" required />
            </div>

            <hr />
            <h5>Criteria</h5>
            <div id="criteria-container">
                <div class="card mb-2 criterion-item">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3 mb-2">
                                <input type="text" name="Criteria[0].Criterion" class="form-control form-control-sm" placeholder="Criterion name" required />
                            </div>
                            <div class="col-md-4 mb-2">
                                <input type="text" name="Criteria[0].Description" class="form-control form-control-sm" placeholder="Description" />
                            </div>
                            <div class="col-md-2 mb-2">
                                <input type="number" name="Criteria[0].MaxScore" class="form-control form-control-sm" placeholder="Max Score" value="4" />
                            </div>
                            <div class="col-md-2 mb-2">
                                <input type="text" name="Criteria[0].ScoringGuidance" class="form-control form-control-sm" placeholder="Scoring guidance" />
                            </div>
                            <div class="col-md-1 mb-2">
                                <button type="button" class="btn btn-sm btn-danger remove-criterion" disabled>&times;</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <button type="button" id="add-criterion" class="btn btn-sm btn-outline-secondary mb-3">+ Add Criterion</button>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Rubric</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
    var criterionIndex = 1;
    document.getElementById("add-criterion").addEventListener("click", function() {
        var container = document.getElementById("criteria-container");
        var html = 
            \'<div class="card mb-2 criterion-item">\' +
            \'  <div class="card-body">\' +
            \'    <div class="row">\' +
            \'      <div class="col-md-3 mb-2">\' +
            \'        <input type="text" name="Criteria[" + criterionIndex + "].Criterion" class="form-control form-control-sm" placeholder="Criterion name" required />\' +
            \'      </div>\' +
            \'      <div class="col-md-4 mb-2">\' +
            \'        <input type="text" name="Criteria[" + criterionIndex + "].Description" class="form-control form-control-sm" placeholder="Description" />\' +
            \'      </div>\' +
            \'      <div class="col-md-2 mb-2">\' +
            \'        <input type="number" name="Criteria[" + criterionIndex + "].MaxScore" class="form-control form-control-sm" placeholder="Max Score" value="4" />\' +
            \'      </div>\' +
            \'      <div class="col-md-2 mb-2">\' +
            \'        <input type="text" name="Criteria[" + criterionIndex + "].ScoringGuidance" class="form-control form-control-sm" placeholder="Scoring guidance" />\' +
            \'      </div>\' +
            \'      <div class="col-md-1 mb-2">\' +
            \'        <button type="button" class="btn btn-sm btn-danger remove-criterion">&times;</button>\' +
            \'      </div>\' +
            \'    </div>\' +
            \'  </div>\' +
            \'</div>\';
        container.insertAdjacentHTML("beforeend", html);
        criterionIndex++;
        updateRemoveButtons();
    });
    document.addEventListener("click", function(e) {
        if (e.target.classList.contains("remove-criterion")) {
            e.target.closest(".criterion-item").remove();
            updateRemoveButtons();
        }
    });
    function updateRemoveButtons() {
        var items = document.querySelectorAll(".criterion-item");
        items.forEach(function(item, i) {
            var btn = item.querySelector(".remove-criterion");
            if (btn) btn.disabled = items.length <= 1;
        });
    }
</script>
