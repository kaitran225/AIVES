@model RubricCreateViewModel

@{
    ViewData["Title"] = "Create Rubric";
}

<h2>Create Rubric</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row">
    <div class="col-md-8">
        @if (Model.Step == 1)
        {
            <partial name="_RubricStep1" model="Model" />
        }
        else
        {
            <partial name="_RubricStep2" model="Model" />
        }
    </div>
</div>