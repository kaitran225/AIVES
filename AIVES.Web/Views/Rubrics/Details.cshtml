@model AIVES.Business.DTOs.RubricDto

@{
    ViewData["Title"] = "Rubric Details";
}

<h2>@Model.Name</h2>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Rubric Details</h5>
        <span class="badge bg-info">Max Score: @Model.MaxScore</span>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-muted">@Model.Description</p>
        }
        <hr />
        <h6>Criteria</h6>
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Criterion</th>
                    <th>Description</th>
                    <th>Max Score</th>
                    <th>Scoring Guidance</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Criteria.Count; i++)
                {
                    var c = Model.Criteria[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td><strong>@c.Criterion</strong></td>
                        <td>@c.Description</td>
                        <td><span class="badge bg-secondary">@c.MaxScore</span></td>
                        <td class="small">@c.ScoringGuidance</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
