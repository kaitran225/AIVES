@model RubricDetailViewModel

@{
    ViewData["Title"] = "Rubric Details";
}

<h2>@Model.Name</h2>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Rubric Details</h5>
        <span class="badge bg-info">Max Score: @Model.MaxScore</span>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-muted">@Model.Description</p>
        }

        <h6>Performance Levels</h6>
        <div class="table-responsive">
            <table class="table table-bordered table-sm">
                <thead class="table-light">
                    <tr>
                        <th>Level</th>
                        <th>Label</th>
                        <th>Sort Order</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var level in Model.PerformanceLevels.OrderBy(p => p.SortOrder))
                    {
                        <tr>
                            <td>@level.Level</td>
                            <td>@level.Label</td>
                            <td>@level.SortOrder</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <hr />

        <h6>Criteria Matrix</h6>
        @if (Model.Criteria.Count == 0)
        {
            <p class="text-muted">No criteria defined.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th rowspan="2" style="min-width: 200px;">Criterion</th>
                            @foreach (var level in Model.PerformanceLevels.OrderBy(p => p.SortOrder))
                            {
                                <th colspan="1" class="text-center" style="min-width: 200px;">
                                    Level @level.Level: @level.Label
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Criteria.Count; i++)
                        {
                            var c = Model.Criteria[i];
                            <tr>
                                <td><strong>@c.Criterion</strong></td>
                                @foreach (var level in Model.PerformanceLevels.OrderBy(p => p.SortOrder))
                                {
                                    var desc = c.LevelDescriptions.FirstOrDefault(d => d.PerformanceLevelId == level.Id);
                                    <td class="small">@(desc?.Description ?? "—")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>