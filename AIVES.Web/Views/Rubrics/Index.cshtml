@model IEnumerable<RubricIndexViewModel>

@{
    ViewData["Title"] = "Rubric Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Grading Rubrics</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Rubric</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    @foreach (var rubric in Model)
    {
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@rubric.Name</h5>
                    <span class="badge bg-info">@rubric.MaxScore pts</span>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(rubric.Description))
                    {
                        <p class="text-muted small">@rubric.Description</p>
                    }
                    <div class="mb-2">
                        <small class="text-muted">@rubric.CriteriaCount criteria</small>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@rubric.Id" class="btn btn-sm btn-outline-primary">View</a>
                        <a asp-action="Edit" asp-route-id="@rubric.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@rubric.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this rubric?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info text-center">No rubrics found. Create your first rubric.</div>
        </div>
    }
</div>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-link">&larr; Back to Home</a>
</div>