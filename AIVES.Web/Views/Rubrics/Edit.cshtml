@model RubricUpdateViewModel

@{
    ViewData["Title"] = "Edit Rubric";
}

<h2>Edit Rubric: @Model.Name</h2>
<p class="text-muted">Criteria scores must add up to the rubric maximum score.</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row">
    <div class="col-md-9">
        <form asp-action="Edit" method="post" id="rubricForm">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Rubric Name *</label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="MaxScore" class="form-label">Maximum Score *</label>
                <input asp-for="MaxScore" id="maxScoreInput" type="number" class="form-control" min="1" max="100" required />
                <div class="form-text">Total points available across all criteria. Changing this rebalances the criteria.</div>
                <span asp-validation-for="MaxScore" class="text-danger"></span>
            </div>

            <hr />

            <partial name="_CriteriaEditor" model="Model" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
