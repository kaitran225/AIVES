@model RubricFormViewModel

@*
    Matrix rubric editor: Performance Levels (columns) × Criteria (rows)
    Each cell contains a description for that criterion at that level.
*@

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Performance Levels</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-info">
            Define the performance levels (columns) for the rubric matrix.
            Levels must be sequential starting from 1 up to Max Score.
        </div>

        <div class="row fw-bold small text-muted mb-2">
            <div class="col-md-2">Level</div>
            <div class="col-md-4">Label</div>
            <div class="col-md-2">Sort Order</div>
            <div class="col-md-2"></div>
        </div>

        <div id="levels-container">
            @for (var i = 0; i < Model.PerformanceLevels.Count; i++)
            {
                var l = Model.PerformanceLevels[i];
                <div class="row mb-2 level-item align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small mb-1 d-md-none">Level</label>
                        <input type="hidden" name="PerformanceLevels[@i].Id" value="@l.Id" />
                        <input type="number" name="PerformanceLevels[@i].Level" class="form-control form-control-sm level-number"
                               value="@l.Level" min="1" max="@Model.MaxScore" required readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1 d-md-none">Label</label>
                        <input type="text" name="PerformanceLevels[@i].Label" class="form-control form-control-sm level-label"
                               value="@l.Label" placeholder="e.g., Beginning" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1 d-md-none">Sort Order</label>
                        <input type="number" name="PerformanceLevels[@i].SortOrder" class="form-control form-control-sm level-sort"
                               value="@l.SortOrder" min="0" step="1" required />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-sm btn-outline-danger remove-level" title="Remove level">&times;</button>
                    </div>
                </div>
            }
        </div>

        <button type="button" id="add-level" class="btn btn-sm btn-outline-secondary mb-3">+ Add Performance Level</button>

        @* Template for new level *@
        <template id="level-template">
            <div class="row mb-2 level-item align-items-end">
                <div class="col-md-2">
                    <label class="form-label small mb-1 d-md-none">Level</label>
                    <input type="hidden" name="PerformanceLevels[__i__].Id" value="0" />
                    <input type="number" name="PerformanceLevels[__i__].Level" class="form-control form-control-sm level-number"
                           value="__level__" min="1" max="__maxScore__" required readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1 d-md-none">Label</label>
                    <input type="text" name="PerformanceLevels[__i__].Label" class="form-control form-control-sm level-label"
                           placeholder="e.g., Beginning" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1 d-md-none">Sort Order</label>
                    <input type="number" name="PerformanceLevels[__i__].SortOrder" class="form-control form-control-sm level-sort"
                           value="__level__" min="0" step="1" required />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-level" title="Remove level">&times;</button>
                </div>
            </div>
        </template>
    </div>
</div>

<hr />

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Criteria Matrix</h5>
        <button type="button" id="add-criterion" class="btn btn-sm btn-outline-primary">+ Add Criterion</button>
    </div>
    <div class="card-body">
        @if (Model.PerformanceLevels.Count == 0)
        {
            <div class="alert alert-warning">
                Add at least one performance level above before adding criteria.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle" id="criteria-table">
                    <thead class="table-light">
                        <tr>
                            <th rowspan="2" style="width: 200px; min-width: 200px;">Criterion</th>
                            @foreach (var level in Model.PerformanceLevels.OrderBy(p => p.SortOrder))
                            {
                                <th colspan="2" class="text-center" style="min-width: 200px;">
                                    Level @level.Level: @level.Label
                                </th>
                            }
                            <th rowspan="2" style="width: 50px;"></th>
                        </tr>
                        <tr>
                            @foreach (var level in Model.PerformanceLevels.OrderBy(p => p.SortOrder))
                            {
                                <th class="text-center" style="min-width: 100px;">Description</th>
                            }
                        </tr>
                    </thead>
                    <tbody id="criteria-rows">
                        @for (var i = 0; i < Model.Criteria.Count; i++)
                        {
                            var c = Model.Criteria[i];
                            <tr class="criterion-row" data-index="@i">
                                <td>
                                    <input type="hidden" name="Criteria[@i].Id" value="@c.Id" class="criterion-id" />
                                    <input type="hidden" name="Criteria[@i].SortOrder" value="@c.SortOrder" class="criterion-sort" />
                                    <input type="text" name="Criteria[@i].Criterion" class="form-control form-control-sm criterion-name"
                                           value="@c.Criterion" placeholder="Criterion name" required />
                                </td>
                                @foreach (var level in Model.PerformanceLevels.OrderBy(p => p.SortOrder))
                                {
                                    var desc = c.LevelDescriptions.FirstOrDefault(d => d.PerformanceLevelId == level.Id);
                                    var descId = desc?.Id ?? 0;
                                    var descText = desc?.Description ?? "";
                                    <td>
                                        <input type="hidden" name="Criteria[@i].LevelDescriptions[@level.Id].Id" value="@descId" />
                                        <input type="hidden" name="Criteria[@i].LevelDescriptions[@level.Id].PerformanceLevelId" value="@level.Id" />
                                        <textarea name="Criteria[@i].LevelDescriptions[@level.Id].Description"
                                                  class="form-control form-control-sm criterion-desc"
                                                  rows="2" placeholder="Description for Level @level.Level" required>@descText</textarea>
                                    </td>
                                }
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger remove-criterion" title="Remove criterion">&times;</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Criteria.Count == 0)
            {
                <p class="text-muted small text-center py-3" id="criteria-empty-hint">
                    No criteria yet. Use <strong>+ Add Criterion</strong> to create one.
                </p>
            }
        }
    </div>
</div>

@* Template for new criterion row *@
<template id="criterion-template">
    <tr class="criterion-row" data-index="__i__">
        <td>
            <input type="hidden" name="Criteria[__i__].Id" value="0" class="criterion-id" />
            <input type="hidden" name="Criteria[__i__].SortOrder" value="__i__" class="criterion-sort" />
            <input type="text" name="Criteria[__i__].Criterion" class="form-control form-control-sm criterion-name" placeholder="Criterion name" required />
        </td>
        @foreach (var level in Model.PerformanceLevels.OrderBy(p => p.SortOrder))
        {
            <td>
                <input type="hidden" name="Criteria[__i__].LevelDescriptions[@level.Id].Id" value="0" />
                <input type="hidden" name="Criteria[__i__].LevelDescriptions[@level.Id].PerformanceLevelId" value="@level.Id" />
                <textarea name="Criteria[__i__].LevelDescriptions[@level.Id].Description"
                          class="form-control form-control-sm criterion-desc"
                          rows="2" placeholder="Description for Level @level.Level" required></textarea>
            </td>
        }
        <td>
            <button type="button" class="btn btn-sm btn-outline-danger remove-criterion" title="Remove criterion">&times;</button>
        </td>
    </tr>
</template>

<script>
    (function () {
        var form = document.getElementById('rubricForm');
        var maxScoreInput = document.getElementById('maxScoreInput');
        var levelsContainer = document.getElementById('levels-container');
        var levelTemplate = document.getElementById('level-template');
        var addLevelBtn = document.getElementById('add-level');
        var criteriaTable = document.getElementById('criteria-table');
        var criteriaRows = document.getElementById('criteria-rows');
        var criterionTemplate = document.getElementById('criterion-template');
        var addCriterionBtn = document.getElementById('add-criterion');
        var emptyHint = document.getElementById('criteria-empty-hint');

        if (!form || !maxScoreInput) return;

        function getLevels() {
            return Array.prototype.slice.call(levelsContainer.querySelectorAll('.level-item'));
        }

        function getRows() {
            return criteriaRows ? Array.prototype.slice.call(criteriaRows.querySelectorAll('.criterion-row')) : [];
        }

        function reindexLevels() {
            var levels = getLevels();
            levels.forEach(function (row, index) {
                row.querySelectorAll('[name]').forEach(function (input) {
                    input.name = input.name.replace(/PerformanceLevels\[\w+\]/, 'PerformanceLevels[' + index + ']');
                });
                // Update sort order to match index + 1
                var sortInput = row.querySelector('.level-sort');
                if (sortInput) sortInput.value = index + 1;
            });
        }

        function reindexCriteria() {
            var rows = getRows();
            rows.forEach(function (row, index) {
                row.dataset.index = index;
                row.querySelectorAll('[name]').forEach(function (input) {
                    input.name = input.name.replace(/Criteria\[\w+\]/, 'Criteria[' + index + ']');
                });
                var sortInput = row.querySelector('.criterion-sort');
                if (sortInput) sortInput.value = index;
            });
        }

        function getPerformanceLevels() {
            var levels = [];
            getLevels().forEach(function (row) {
                var levelInput = row.querySelector('.level-number');
                var labelInput = row.querySelector('.level-label');
                if (levelInput && labelInput) {
                    levels.push({
                        id: levelInput.name.match(/PerformanceLevels\[(\d+)\]/)?.[1] || 'new',
                        level: parseInt(levelInput.value, 10),
                        label: labelInput.value.trim()
                    });
                }
            });
            return levels.sort(function (a, b) { return a.level - b.level; });
        }

        function updateCriterionColumns() {
            if (!criteriaTable || !criteriaRows) return;
            var levels = getPerformanceLevels();
            var maxScore = parseInt(maxScoreInput.value, 10) || 0;

            // Update header
            var thead = criteriaTable.querySelector('thead');
            if (thead) {
                var headerRow = thead.querySelector('tr');
                if (headerRow) {
                    // Keep first cell (Criterion) and last cell (actions)
                    var firstCell = headerRow.querySelector('th:first-child');
                    var lastCell = headerRow.querySelector('th:last-child');
                    var middleCells = headerRow.querySelectorAll('th:not(:first-child):not(:last-child)');
                    middleCells.forEach(function (cell) { cell.remove(); });

                    levels.forEach(function (level) {
                        var th = document.createElement('th');
                        th.colSpan = 1;
                        th.className = 'text-center';
                        th.style.minWidth = '200px';
                        th.textContent = 'Level ' + level.level + ': ' + level.label;
                        if (lastCell) {
                            headerRow.insertBefore(th, lastCell);
                        } else {
                            headerRow.appendChild(th);
                        }
                    });
                }
            }

            // Update each criterion row
            var rows = getRows();
            rows.forEach(function (row) {
                var cells = row.querySelectorAll('td');
                var criterionCell = cells[0];
                var actionCell = cells[cells.length - 1];

                // Remove existing level cells
                for (var i = 1; i < cells.length - 1; i++) {
                    cells[i].remove();
                }

                // Add new level cells
                levels.forEach(function (level) {
                    var td = document.createElement('td');
                    var levelDescTemplate = '<input type="hidden" name="Criteria[' + row.dataset.index + '].LevelDescriptions[' + level.level + '].Id" value="0" />' +
                        '<input type="hidden" name="Criteria[' + row.dataset.index + '].LevelDescriptions[' + level.level + '].PerformanceLevelId" value="' + level.level + '" />' +
                        '<textarea name="Criteria[' + row.dataset.index + '].LevelDescriptions[' + level.level + '].Description" class="form-control form-control-sm criterion-desc" rows="2" placeholder="Description for Level ' + level.level + '" required></textarea>';
                    td.innerHTML = levelDescTemplate;
                    row.insertBefore(td, actionCell);
                });
            });
        }

        // Add performance level
        if (addLevelBtn) {
            addLevelBtn.addEventListener('click', function () {
                var levels = getLevels();
                var maxScore = parseInt(maxScoreInput.value, 10) || 4;
                if (levels.length >= maxScore) {
                    alert('Cannot have more levels than Max Score (' + maxScore + ').');
                    return;
                }
                var nextLevel = levels.length + 1;
                var html = levelTemplate.innerHTML
                    .replace(/__i__/g, levels.length)
                    .replace(/__level__/g, nextLevel)
                    .replace(/__maxScore__/g, maxScore);
                var div = document.createElement('div');
                div.innerHTML = html.trim();
                levelsContainer.appendChild(div.firstElementChild);
                reindexLevels();
                updateCriterionColumns();
            });
        }

        // Remove performance level
        levelsContainer.addEventListener('click', function (e) {
            if (!e.target.classList.contains('remove-level')) return;
            var levels = getLevels();
            if (levels.length <= 1) return;
            e.target.closest('.level-item').remove();
            reindexLevels();
            updateCriterionColumns();
        });

        // Max score change
        maxScoreInput.addEventListener('change', function () {
            var maxScore = parseInt(maxScoreInput.value, 10) || 4;
            var levels = getLevels();
            var filledLevels = levels.filter(function (l) {
                return l.querySelector('.level-label').value.trim() !== '';
            });

            if (filledLevels.length > maxScore) {
                alert('Max Score cannot be less than the number of filled performance levels (' + filledLevels.length + ').');
                maxScoreInput.value = filledLevels.length;
                return;
            }

            // Update max attribute on level inputs
            levels.forEach(function (row) {
                var levelInput = row.querySelector('.level-number');
                if (levelInput) levelInput.max = maxScore;
            });
        });

        // Add criterion
        if (addCriterionBtn && criteriaRows) {
            addCriterionBtn.addEventListener('click', function () {
                var rows = getRows();
                var html = criterionTemplate.innerHTML.replace(/__i__/g, rows.length);
                var tr = document.createElement('tr');
                tr.innerHTML = html.trim();
                criteriaRows.appendChild(tr.firstElementChild);
                reindexCriteria();
                if (emptyHint) emptyHint.style.display = 'none';
            });
        }

        // Remove criterion
        criteriaRows?.addEventListener('click', function (e) {
            if (!e.target.classList.contains('remove-criterion')) return;
            var rows = getRows();
            if (rows.length <= 1) return;
            e.target.closest('.criterion-row').remove();
            reindexCriteria();
            if (emptyHint && getRows().length === 0) emptyHint.style.display = 'block';
        });

        // Initialize
        if (levelsContainer) {
            levelsContainer.querySelectorAll('.level-number').forEach(function (input) {
                input.max = maxScoreInput.value;
            });
        }
        if (emptyHint && getRows().length > 0) emptyHint.style.display = 'none';
    })();
</script>