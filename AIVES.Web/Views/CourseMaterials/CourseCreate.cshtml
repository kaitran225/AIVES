@model CourseFormViewModel

@{
    ViewData["Title"] = "New Course";
}

<h2>New Course</h2>
<p class="text-muted">Create a course together with its topics. Topics defined here become available in the question bank, AI generator and material filters.</p>

<div class="row">
    <div class="col-md-8">
        <form asp-action="CourseCreate" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Code" class="form-label">Course Code *</label>
                    <input asp-for="Code" class="form-control" placeholder="e.g., CS101" required />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <div class="col-md-8 mb-3">
                    <label asp-for="Name" class="form-label">Course Name *</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g., Introduction to Programming" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="InitialTopics" class="form-label">Initial Topics</label>
                <textarea asp-for="InitialTopics" class="form-control" rows="6"
                          placeholder="One topic per line, e.g.&#10;Variables and Data Types&#10;Control Flow&#10;Functions&#10;Object-Oriented Programming"></textarea>
                <div class="form-text">One topic per line. Created together with the course. You can add more later from the Courses &amp; Topics page.</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Course</button>
                <a asp-action="Manage" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
