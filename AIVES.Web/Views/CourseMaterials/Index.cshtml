@model IEnumerable<CourseMaterialIndexViewModel>

@{
    ViewData["Title"] = "Course Materials";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Course Materials</h2>
        <small class="text-muted">Manage <a asp-action="Manage">courses &amp; topics</a> here — every dropdown in the app reads from there.</small>
    </div>
    <div>
        <a asp-action="Manage" class="btn btn-outline-primary me-2">Courses &amp; Topics</a>
        <a asp-action="Create" asp-route-courseId="@ViewData["CourseId"]" class="btn btn-primary">+ Import Material</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Course</th>
                    <th>Type</th>
                    <th>Chunks</th>
                    <th>Imported</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.Id</td>
                        <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@m.Title">@m.Title</td>
                        <td>@m.CourseName</td>
                        <td><span class="badge bg-light text-dark">@m.SourceType</span></td>
                        <td><span class="badge bg-info">@m.ChunkCount</span></td>
                        <td>@m.ImportedAt:dd/MM/yyyy</td>
                        <td>
                            <a asp-action="Preview" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary me-1">Preview</a>
                            <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline" onsubmit="return confirm(\\"Delete this material?\\");">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No materials imported yet. Import your first course material.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-link">&larr; Back to Home</a>
</div>
