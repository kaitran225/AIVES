@model AIVES.Business.DTOs.CourseMaterialDto

@{
    ViewData["Title"] = "Material Preview: " + Model.Title;
}

<h2>@Model.Title</h2>

<div class="card mb-4">
    <div class="card-header">
        <h6 class="mb-0">Material Information</h6>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 mb-2"><strong>Course:</strong> @Model.CourseName</div>
            <div class="col-md-4 mb-2"><strong>Type:</strong> @Model.SourceType</div>
            <div class="col-md-4 mb-2"><strong>Chunks:</strong> @Model.ChunkCount</div>
            <div class="col-md-4 mb-2"><strong>Imported:</strong> @Model.ImportedAt:dd/MM/yyyy HH:mm</div>
            @if (!string.IsNullOrEmpty(Model.FileName))
            {
                <div class="col-md-4 mb-2"><strong>File:</strong> @Model.FileName</div>
            }
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h6 class="mb-0">Content Preview (first 2000 chars)</h6>
    </div>
    <div class="card-body">
        <pre class="bg-light p-3" style="max-height: 400px; overflow-y: auto; white-space: pre-wrap;">@Model.Content.Substring(0, Math.Min(2000, Model.Content.Length))</pre>
        @if (Model.Content.Length > 2000)
        {
            <p class="text-muted small">... (truncated. Full content available in database.)</p>
        }
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Index" class="btn btn-secondary">Back to Materials</a>
</div>
