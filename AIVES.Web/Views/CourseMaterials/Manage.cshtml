@model CourseManagerViewModel

@{
    ViewData["Title"] = "Courses & Topics";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Courses &amp; Topics</h2>
        <p class="text-muted mb-0">Single source of truth for courses and their topics. Every course/topic dropdown in the app reads from here.</p>
    </div>
    <div>
        <a asp-action="CourseCreate" class="btn btn-primary me-2">+ New Course</a>
        <a asp-action="Index" class="btn btn-secondary">Back to Materials</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Courses.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h5>No courses yet</h5>
            <p class="text-muted">Create a course and its topics before importing materials or building the question bank.</p>
            <a asp-action="CourseCreate" class="btn btn-primary">+ New Course</a>
        </div>
    </div>
}
else
{
    foreach (var course in Model.Courses)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>@course.Code</strong> — @course.Name
                    <span class="badge bg-secondary ms-2">@course.Topics.Count topic(s)</span>
                    <span class="badge bg-info ms-1">@course.MaterialCount material(s)</span>
                    <span class="badge bg-dark ms-1">@course.QuestionCount question(s)</span>
                </div>
                <div class="btn-group btn-group-sm">
                    <a asp-action="CourseEdit" asp-route-id="@course.Id" class="btn btn-outline-secondary">Edit Course</a>
                    <a asp-action="Create" asp-route-courseId="@course.Id" class="btn btn-outline-primary">+ Material</a>
                    <a asp-action="Index" asp-route-courseId="@course.Id" class="btn btn-outline-primary">Materials</a>
                    <form asp-action="CourseDelete" asp-route-id="@course.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete course @course.Code and all of its topics?');">
                        <button type="submit" class="btn btn-outline-danger">Delete</button>
                    </form>
                </div>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(course.Description))
                {
                    <p class="text-muted small">@course.Description</p>
                }

                <table class="table table-sm table-hover mb-3">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px;">ID</th>
                            <th>Topic</th>
                            <th>Description</th>
                            <th style="width:120px;">Questions</th>
                            <th style="width:180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var topic in course.Topics)
                        {
                            <tr>
                                <td>@topic.Id</td>
                                <td>@topic.Name</td>
                                <td class="text-muted small">@topic.Description</td>
                                <td><span class="badge bg-light text-dark">@topic.QuestionCount</span></td>
                                <td>
                                    <a asp-action="TopicEdit" asp-route-id="@topic.Id" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                                    <form asp-action="TopicDelete" asp-route-id="@topic.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete topic @topic.Name?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!course.Topics.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">
                                    No topics for this course. Add one below — questions and AI generation both need it.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <form asp-action="TopicCreate" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="CourseId" value="@course.Id" />
                    <div class="col-md-4">
                        <label class="form-label small mb-0" for="topicName_@course.Id">New topic</label>
                        <input type="text" id="topicName_@course.Id" name="Name" class="form-control form-control-sm" placeholder="e.g., Sorting Algorithms" required />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small mb-0" for="topicDesc_@course.Id">Description (optional)</label>
                        <input type="text" id="topicDesc_@course.Id" name="Description" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-sm btn-primary w-100">Add Topic</button>
                    </div>
                </form>
            </div>
        </div>
    }
}

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-link">&larr; Back to Home</a>
</div>
