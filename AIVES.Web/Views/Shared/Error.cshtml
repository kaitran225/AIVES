@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    var env = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "Production";
    Model.IsDevelopment = env.Equals("Development", StringComparison.OrdinalIgnoreCase);
    Model.Environment = env;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Error Occurred</h4>
                </div>
                <div class="card-body">
                    <h1 class="text-danger">Error.</h1>
                    <h2 class="text-danger">An error occurred while processing your request.</h2>

                    @if (Model.IsDevelopment)
                    {
                        <div class="alert alert-warning mt-4">
                            <strong>Development Mode:</strong> Detailed error information is displayed below. In production, this information is hidden for security.
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger mt-3">
                                <h5 class="alert-heading">Error Details</h5>
                                <p><strong>Type:</strong> @Model.ErrorType</p>
                                <p><strong>Message:</strong></p>
                                <pre class="mb-0">@Model.ErrorMessage</pre>
                                @if (!string.IsNullOrEmpty(Model.InnerErrorMessage))
                                {
                                    <hr />
                                    <h6 class="mt-3">Inner Exception:</h6>
                                    <p><strong>Type:</strong> @Model.InnerErrorType</p>
                                    <p><strong>Message:</strong></p>
                                    <pre class="mb-0">@Model.InnerErrorMessage</pre>
                                }
                                @if (!string.IsNullOrEmpty(Model.StackTrace))
                                {
                                    <hr />
                                    <h6 class="mt-3">Stack Trace:</h6>
                                    <pre class="bg-light p-3" style="max-height: 400px; overflow-y: auto; font-size: 0.85rem;">@Model.StackTrace</pre>
                                }
                            </div>
                        }
                        <div class="card mt-4">
                            <div class="card-header bg-secondary text-white">
                                <h6 class="mb-0">Request Context</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6 mb-3"><strong>Timestamp:</strong><br /><span class="text-muted">@Model.Timestamp:dd/MM/yyyy HH:mm:ss.fff</span></div>
                                    <div class="col-md-6 mb-3"><strong>Environment:</strong><br /><span class="badge bg-@(Model.IsDevelopment ? "success" : "secondary")">@Model.Environment</span></div>
                                    <div class="col-md-6 mb-3"><strong>URL:</strong><br /><code class="text-break">@Model.Url</code></div>
                                    <div class="col-md-6 mb-3"><strong>HTTP Method:</strong><br /><span class="badge bg-primary">@Model.HttpMethod</span></div>
                                    <div class="col-md-6 mb-3"><strong>Request ID:</strong><br /><code>@Model.RequestId</code></div>
                                </div>
                                @if (Model.QueryString != null && Model.QueryString.Any())
                                {
                                    <div class="mt-3"><strong>Query String:</strong>
                                        <div class="bg-light p-3 mt-1" style="max-height: 200px; overflow-y: auto;">
                                            <table class="table table-sm table-borderless mb-0"><tbody>
                                                @foreach (var param in Model.QueryString) { <tr><td class="text-muted" style="width: 200px;">@param.Key:</td><td><code class="text-break">@param.Value</code></td></tr> }
                                            </tbody></table>
                                        </div>
                                    </div>
                                }
                                @if (Model.UserAgent != null && Model.UserAgent.Any())
                                {
                                    <div class="mt-3"><strong>User Agent:</strong>
                                        <pre class="bg-light p-2 mt-1" style="font-size: 0.85rem;">@string.Join(", ", Model.UserAgent)</pre>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mt-4">
                            <h5 class="alert-heading">Something went wrong</h5>
                            <p>We are sorry, but an unexpected error has occurred. Please try again later.</p>
                            <hr />
                            <p class="mb-0"><strong>Request ID:</strong> <code>@Model.RequestId</code><br /><strong>Timestamp:</strong> @Model.Timestamp:dd/MM/yyyy HH:mm:ss</p>
                        </div>
                    }
                </div>
                <div class="card-footer text-muted">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to Home</a>
                    <a href="javascript:window.history.back()" class="btn btn-secondary">Go Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
